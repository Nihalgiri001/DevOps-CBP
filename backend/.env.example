# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local development: mongodb://localhost:27017/communitylink
# For Docker Compose: mongodb://mongodb:27017/communitylink
# For Kubernetes: mongodb://mongodb-service:27017/communitylink
MONGODB_URI=mongodb://localhost:27017/communitylink

# JWT Secret Key
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Testing (optional)
# MONGODB_URI_TEST=mongodb://localhost:27017/communitylink_test
